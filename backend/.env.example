# Live mode is the default.
USE_MOCK_MARKET_DATA=false

# Upstox OAuth access token. Never commit a real token.
UPSTOX_ACCESS_TOKEN=YOUR_UPSTOX_ACCESS_TOKEN

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash-lite

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_INTERVAL_SECONDS=300
SIGNIFICANT_PNL_CHANGE=100
SIGNIFICANT_ALERT_COOLDOWN_SECONDS=60

# Keep SSL verification enabled. Only disable temporarily for local certificate troubleshooting.
UPSTOX_VERIFY_SSL=false
TELEGRAM_VERIFY_SSL=false
